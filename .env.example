# ---- Infrastructure (docker compose) ----
MONGO_DB_USERNAME="root"
MONGO_DB_PASSWORD=""
SEAWEEDFS_ADMIN_USER="admin"
SEAWEEDFS_ADMIN_PASSWORD=""

# ---- Backend ----
PORT="8000"
NODE_ENV="development"
BACKEND_URL=""
JWT_SECRET=""
# Host values for running the backend outside Docker; docker-compose overrides MONGODB_URI and SEAWEEDFS_ENDPOINT for containers
MONGODB_URI="mongodb://root:change-me@localhost:27017/data-scraping?authSource=admin"

# ---- SeaweedFS (S3) ----
SEAWEEDFS_ENDPOINT="localhost"
SEAWEEDFS_PORT="8333"
SEAWEEDFS_BUCKET="bucket"
SEAWEEDFS_ACCESS_KEY="seaweedfs_access_key"
SEAWEEDFS_SECRET_KEY="seaweedfs_secret_key"

# ---- Twilio ----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# ---- Square ----
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
SQUARE_ENVIRONMENT="sandbox"
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_PRODUCT_NAME=""
SQUARE_CURRENCY=""

# ---- Stripe ----
STRIPE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRODUCT_NAME=""
STRIPE_CURRENCY=""

# ---- Frontend (baked into the Next.js build) ----
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_MINIO_BUCKET="bucket"
